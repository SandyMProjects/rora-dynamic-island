{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "alwaysOnTop": true,
        "decorations": false,
        "height": 46,
        "minHeight": 44,
        "minWidth": 160,
        "maximizable": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "title": "RORA Island",
        "transparent": true,
        "visible": true,
        "width": 196,
        "maxWidth": 340,
        "maxHeight": 180
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "identifier": "com.rora.island",
  "productName": "RORA Island",
  "version": "0.1.0"
}
